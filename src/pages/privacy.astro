---
import BaseLayout from '../layouts/BaseLayout.astro'
import { LegalPage } from '../views/LegalPage'
import { SEO, SITE_URL } from '../data/site'
import { PRIVACY_SECTIONS } from '../data/legal'

const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Privacy', item: `${SITE_URL}/privacy` },
    ],
  },
]
---

<BaseLayout seo={SEO.privacy} jsonLdExtra={jsonLdExtra}>
  <LegalPage
    client:visible
    docTitle="Privacy Policy"
    intro="This policy describes how The Isle Cheats handles information when you use theislecheats.cc and purchase through our checkout partner."
    sections={PRIVACY_SECTIONS}
  />
</BaseLayout>
