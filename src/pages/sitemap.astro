---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SitemapPage } from '../views/SitemapPage'
import { SEO, SITE_URL } from '../data/site'

const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Sitemap', item: `${SITE_URL}/sitemap` },
    ],
  },
]
---

<BaseLayout seo={SEO.sitemap} jsonLdExtra={jsonLdExtra}>
  <SitemapPage client:visible />
</BaseLayout>
